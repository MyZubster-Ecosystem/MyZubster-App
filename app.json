{
  "expo": {
    "name": "myzubster-app",
    "slug": "myzubster-app",
    "scheme": "myzubster",
    "version": "1.0.0",
    "sdkVersion": "51.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "com.anonymous.myzubsterapp",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Consenti a MyZubster di scansionare indirizzi Monero.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-location"
    ],
    "extra": {
      "apiUrl": "http://192.168.1.10:3000/api",
      "eas": {
        "projectId": "066d68ca-b5ec-4ec3-94cf-e5cf8890718d"
      }
    }
  }
}
