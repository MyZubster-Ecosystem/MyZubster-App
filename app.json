{
  "expo": {
    "name": "MyZubster Lavori",
    "slug": "myzubster-app",
    "version": "1.0.1",
    "scheme": "myzubster",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myzubster.app"
    },
    "android": {
      "package": "com.myzubster.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-location",
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "https://www.myzubster.com/api"
    }
  }
}
